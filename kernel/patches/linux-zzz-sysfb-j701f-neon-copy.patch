--- /dev/null
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_j701f_neon.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Written by Claude 2026-10-10 (J701F local). NEON line converters for the
+ * copy into the bootloader framebuffer; built with FP/SIMD enabled and only
+ * called between kernel_neon_begin() and kernel_neon_end()
+ * (drm_sysfb_modeset.c). Pixels are little-endian XRGB8888 in, ARGB8888 out.
+ */
+#include <linux/types.h>
+#include <asm/neon-intrinsics.h>
+
+/* arm_neon.h imports compiler stdint.h; kernel limits owns these names. */
+#undef UINTPTR_MAX
+#undef SIZE_MAX
+
+#include "drm_sysfb_helper.h"
+
+static const u8 j701f_alpha[16] = {
+	0, 0, 0, 0xff, 0, 0, 0, 0xff, 0, 0, 0, 0xff, 0, 0, 0, 0xff,
+};
+
+/* dst = src | 0xff000000 for @pixels pixels */
+void drm_sysfb_j701f_neon_opaque(u8 *dst, const u8 *src, unsigned int pixels)
+{
+	const uint8x16_t alpha = vld1q_u8(j701f_alpha);
+
+	for (; pixels >= 8; pixels -= 8, src += 32, dst += 32) {
+		vst1q_u8(dst, vorrq_u8(vld1q_u8(src), alpha));
+		vst1q_u8(dst + 16, vorrq_u8(vld1q_u8(src + 16), alpha));
+	}
+	for (; pixels; pixels--, src += 4, dst += 4) {
+		dst[0] = src[0];
+		dst[1] = src[1];
+		dst[2] = src[2];
+		dst[3] = 0xff;
+	}
+}
+
+/* dst = round(src * level / 256) per colour channel, alpha 0xff; @level is 0..255 */
+void drm_sysfb_j701f_neon_dimmed(u8 *dst, const u8 *src, unsigned int pixels, unsigned int level)
+{
+	const uint8x16_t alpha = vld1q_u8(j701f_alpha);
+	const uint8x8_t f = vdup_n_u8(level);
+
+	for (; pixels >= 4; pixels -= 4, src += 16, dst += 16) {
+		uint8x16_t v = vld1q_u8(src);
+		uint8x8_t lo = vrshrn_n_u16(vmull_u8(vget_low_u8(v), f), 8);
+		uint8x8_t hi = vrshrn_n_u16(vmull_u8(vget_high_u8(v), f), 8);
+
+		vst1q_u8(dst, vorrq_u8(vcombine_u8(lo, hi), alpha));
+	}
+	for (; pixels; pixels--, src += 4, dst += 4) {
+		dst[0] = (src[0] * level + 128) >> 8;
+		dst[1] = (src[1] * level + 128) >> 8;
+		dst[2] = (src[2] * level + 128) >> 8;
+		dst[3] = 0xff;
+	}
+}

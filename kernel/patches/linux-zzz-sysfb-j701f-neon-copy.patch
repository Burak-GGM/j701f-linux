From: Claude <noreply@anthropic.com>
Subject: drm/sysfb: NEON line converters for the J701F framebuffer copy

Written by Claude 2026-10-10 for the J701F project; not an upstream patch.
Applies on top of linux-zz-simpledrm-j701f-software-backlight.patch. The plain
and the dimmed copy into the bootloader framebuffer use NEON when kernel-mode
SIMD is available, 32 lines per section; the scalar code stays as fallback.
---
--- a/drivers/gpu/drm/sysfb/Makefile
+++ b/drivers/gpu/drm/sysfb/Makefile
@@ -4,6 +4,12 @@
 	drm_sysfb.o \
 	drm_sysfb_modeset.o
 drm_sysfb_helper-$(CONFIG_SCREEN_INFO) += drm_sysfb_screen_info.o
+# J701F local: NEON line converters for the framebuffer copy
+ifeq ($(CONFIG_ARM64)$(CONFIG_KERNEL_MODE_NEON),yy)
+drm_sysfb_helper-y += drm_sysfb_j701f_neon.o
+CFLAGS_drm_sysfb_j701f_neon.o += $(CC_FLAGS_FPU)
+CFLAGS_REMOVE_drm_sysfb_j701f_neon.o += $(CC_FLAGS_NO_FPU)
+endif
 obj-$(CONFIG_DRM_SYSFB_HELPER)	+= drm_sysfb_helper.o
 
 obj-$(CONFIG_DRM_COREBOOTDRM)	+= corebootdrm.o
--- a/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_helper.h
@@ -131,6 +131,10 @@
 
 void drm_sysfb_plane_redraw(struct drm_plane *plane);
 
+/* J701F local, drm_sysfb_j701f_neon.c: call only inside a kernel-mode NEON section */
+void drm_sysfb_j701f_neon_opaque(u8 *dst, const u8 *src, unsigned int pixels);
+void drm_sysfb_j701f_neon_dimmed(u8 *dst, const u8 *src, unsigned int pixels, unsigned int level);
+
 #define DRM_SYSFB_PLANE_FORMAT_MODIFIERS \
 	DRM_FORMAT_MOD_LINEAR, \
 	DRM_FORMAT_MOD_INVALID
--- a/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
@@ -19,6 +19,15 @@
 
 #include "drm_sysfb_helper.h"
 
+#if defined(CONFIG_ARM64) && defined(CONFIG_KERNEL_MODE_NEON)
+#include <asm/simd.h>
+#define J701F_NEON 1
+/* Lines converted per kernel-mode NEON section (preemption is off inside one). */
+#define J701F_NEON_LINES 32
+#else
+#define J701F_NEON 0
+#endif

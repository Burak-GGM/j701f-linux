+/* Vendor cod3026x_mic_bias_ev() for internal bias 1, the main microphone's. */
+static int cod3026x_micbias1_ev(struct snd_soc_dapm_widget *w,
+				struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	const unsigned int mask = PDB_MCB1_MASK | PDB_MCB_LDO_CODEC_MASK;
+
+	snd_soc_component_update_bits(c, COD3026X_10_PD_REF, mask,
+				      event == SND_SOC_DAPM_PRE_PMU ? mask : 0);
+	return 0;
+}
+
+/* Internal bias 2 feeds the headset microphone (MIC3); vendor cod3026x_mic_bias_ev(). */
+static int cod3026x_micbias2_ev(struct snd_soc_dapm_widget *w,
+				struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	const unsigned int mask = PDB_MCB2_MASK | PDB_MCB_LDO_CODEC_MASK;
+	bool on = event == SND_SOC_DAPM_PRE_PMU;
+
+	snd_soc_component_update_bits(c, COD3026X_10_PD_REF, mask, on ? mask : 0);
+	snd_soc_component_update_bits(c, COD3026X_18_CTRL_REF, CTRM_MCB2_MASK,
+				      on ? CTRM_MCB2_MASK : 0);
+	return 0;
+}
+
+/*
+ * Vendor cod3026_power_on_micN() / cod3026_power_off_micN() for the three
+ * microphone inputs (no bypass mode). The widget's shift selects the input.
+ * The mixer, modulator and bias generator are shared: they stay up while any
+ * other microphone is still selected in the MIC_ON register.
+ */
+static const struct {
+	unsigned int mix, amp, sel;
+} cod3026x_mics[] = {
+	{ EN_MIX_MIC1L_MASK | EN_MIX_MIC1R_MASK, PDB_MIC_PGA1_MASK | PDB_MIC_BST1_MASK, EN_MIC1_MASK },
+	{ EN_MIX_MIC2L_MASK | EN_MIX_MIC2R_MASK, PDB_MIC_PGA2_MASK | PDB_MIC_BST2_MASK, EN_MIC2_MASK },
+	{ EN_MIX_MIC3L_MASK | EN_MIX_MIC3R_MASK, PDB_MIC_PGA3_MASK | PDB_MIC_BST3_MASK, EN_MIC3_MASK },
+};
+
+static int cod3026x_mic_pga_ev(struct snd_soc_dapm_widget *w,
+			       struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	const unsigned int mix = cod3026x_mics[w->shift].mix;
+	const unsigned int amp = cod3026x_mics[w->shift].amp;
+	const unsigned int mixpd = PDB_MIXL_MASK | PDB_MIXR_MASK;
+	const unsigned int dsm = PDB_DSML_MASK | PDB_DSMR_MASK;
+	const unsigned int dsmrst = RESETB_DSML_MASK | RESETB_DSMR_MASK;
+	unsigned int others;
+
+	others = snd_soc_component_read(c, COD3026X_78_MIC_ON) &
+		 (EN_MIC1_MASK | EN_MIC2_MASK | EN_MIC3_MASK) & ~cod3026x_mics[w->shift].sel;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(c, COD3026X_23_MIX_AD1, mix, 0);
+		snd_soc_component_update_bits(c, COD3026X_10_PD_REF,
+					      PDB_IGEN_AD_MASK, PDB_IGEN_AD_MASK);
+		snd_soc_component_update_bits(c, COD3026X_12_PD_AD2, amp, amp);
+		snd_soc_component_update_bits(c, COD3026X_11_PD_AD1, mixpd, mixpd);
+		snd_soc_component_update_bits(c, COD3026X_11_PD_AD1, dsm, dsm);
+		snd_soc_component_update_bits(c, COD3026X_23_MIX_AD1, mix, mix);
+		snd_soc_component_update_bits(c, COD3026X_11_PD_AD1,
+					      EN_DSML_PREQ_MASK | EN_DSMR_PREQ_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_11_PD_AD1, dsmrst, dsmrst);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		if (!others)
+			snd_soc_component_update_bits(c, COD3026X_11_PD_AD1, dsmrst, 0);
+		snd_soc_component_update_bits(c, COD3026X_23_MIX_AD1, mix, 0);
+		if (!others) {
+			snd_soc_component_update_bits(c, COD3026X_11_PD_AD1, dsm, 0);
+			snd_soc_component_update_bits(c, COD3026X_11_PD_AD1, mixpd, 0);
+		}
+		snd_soc_component_update_bits(c, COD3026X_12_PD_AD2, amp, 0);
+		if (!others)
+			snd_soc_component_update_bits(c, COD3026X_10_PD_REF,
+						      PDB_IGEN_AD_MASK, 0);
+		break;
+	}
+	return 0;
+}
+
+/* The ADC is unmuted a little after everything is up, as the vendor's work item does. */
+static int cod3026x_adc_ev(struct snd_soc_dapm_widget *w,
+			   struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		msleep(120);
+		snd_soc_component_update_bits(c, COD3026X_42_ADC1, ADC1_MUTE_AD_EN_MASK, 0);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		snd_soc_component_update_bits(c, COD3026X_42_ADC1,
+					      ADC1_MUTE_AD_EN_MASK, ADC1_MUTE_AD_EN_MASK);
+		break;
+	}
+	return 0;
+}

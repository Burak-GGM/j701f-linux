+static int cod3026x_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct snd_soc_component *c = dai->component;
+	unsigned int format, pol = 0;
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		format = I2S_AUDIO_FORMAT_MASK;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		format = LRJ_AUDIO_FORMAT_MASK;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		pol = BCLK_POL_MASK | LRCLK_POL_MASK;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		pol = BCLK_POL_MASK;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		pol = LRCLK_POL_MASK;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	snd_soc_component_update_bits(c, COD3026X_41_FORMAT,
+				      I2S_AUDIO_FORMAT_MASK | LRJ_AUDIO_FORMAT_MASK |
+				      BCLK_POL_MASK | LRCLK_POL_MASK, format | pol);
+	return 0;
+}

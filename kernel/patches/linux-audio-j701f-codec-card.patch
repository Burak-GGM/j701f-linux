+static int cod3026x_hw_params(struct snd_pcm_substream *substream,
+			      struct snd_pcm_hw_params *params, struct snd_soc_dai *dai)
+{
+	/* The link to the SoC's audio mixer is always 24 bit, as in the vendor driver. */
+	snd_soc_component_update_bits(dai->component, COD3026X_41_FORMAT,
+				      DATA_WORD_LENGTH_MASK,
+				      DATA_WORD_LENGTH_24 << DATA_WORD_LENGTH_SHIFT);
+	return 0;
+}
+
+/*
+ * The DAC stays soft-muted until the stream has actually started, so whatever
+ * the DAC sees while the I2S clocks come up does not reach the amplifier.
+ */
+static int cod3026x_mute_stream(struct snd_soc_dai *dai, int mute, int direction)
+{
+	snd_soc_component_update_bits(dai->component, COD3026X_50_DAC1,
+				      DAC1_SOFT_MUTE_MASK, mute ? DAC1_SOFT_MUTE_MASK : 0);
+	return 0;
+}
+
+static const struct snd_soc_dai_ops cod3026x_dai_ops = {
+	.mute_stream = cod3026x_mute_stream,
+	.no_capture_mute = 1,
+	.set_fmt = cod3026x_set_fmt,
+	.hw_params = cod3026x_hw_params,
+};
+
+static struct snd_soc_dai_driver cod3026x_dai = {
+	.name = "cod3026x-aif",
+	.playback = {
+		.stream_name = "AIF Playback",
+		.channels_min = 2,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.capture = {
+		.stream_name = "AIF Capture",
+		.channels_min = 2,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.ops = &cod3026x_dai_ops,
+};
+
+/*
+ * Headset detection, reporting only. The vendor driver reacts to the codec
+ * interrupt and then reads STATUS1 (bit 0: plug present, bit 1: microphone
+ * present). No interrupt is wired up here yet, so STATUS1 is polled. Nothing
+ * is re-routed: user space sees the jack state and decides.
+ */
+static void cod3026x_jack_work(struct work_struct *work)
+{
+	struct cod3026x *priv = container_of(work, struct cod3026x, jack_work.work);
+	unsigned int st = snd_soc_component_read(priv->component, COD3026X_0B_STATUS1);
+	int report = 0;
+
+	if (st & BIT(STATUS1_JACK_DET_SHIFT))
+		report = (st & BIT(STATUS1_MIC_DET_SHIFT)) ? SND_JACK_HEADSET : SND_JACK_HEADPHONE;
+	if (report != priv->jack_report) {
+		priv->jack_report = report;
+		snd_soc_jack_report(&priv->jack, report, SND_JACK_HEADSET);
+		dev_info(priv->component->dev, "headset jack: %s (STATUS1 %#x)\n",
+			 report == SND_JACK_HEADSET ? "headset" :
+			 report ? "headphones" : "removed", st);
+	}
+	queue_delayed_work(system_freezable_wq, &priv->jack_work, msecs_to_jiffies(COD3026X_JACK_POLL_MS));
+}
+
+static void cod3026x_component_remove(struct snd_soc_component *c)
+{
+	struct cod3026x *priv = snd_soc_component_get_drvdata(c);
+
+	cancel_delayed_work_sync(&priv->jack_work);
+}
+
+static int cod3026x_component_probe(struct snd_soc_component *c)
+{
+	struct cod3026x *priv = snd_soc_component_get_drvdata(c);
+	int i;
+
+	/* Factory trim values, read before anything is written. */
+	for (i = 0; i < COD3026X_OTP_MAX_REG; i++)
+		priv->otp[i] = snd_soc_component_read(c, COD3026X_D0_CTRL_IREF1 + i);
+
+	/* No jack or button handling yet: keep every codec interrupt masked. */
+	snd_soc_component_write(c, COD3026X_06_IRQ1M, 0xff);
+	snd_soc_component_write(c, COD3026X_07_IRQ2M, 0xff);
+	snd_soc_component_write(c, COD3026X_08_IRQ3M, 0xff);
+
+	/* Defaults from the vendor cod3026x_post_fw_update_failure(). */
+	snd_soc_component_write(c, COD3026X_87_LDO_DIG, 0x0f);
+	snd_soc_component_write(c, COD3026X_42_ADC1, 0x0c);
+	snd_soc_component_write(c, COD3026X_5A_DNC7, 0x1a);
+	snd_soc_component_write(c, COD3026X_77_CTRL_CP, 0x02);
+	snd_soc_component_write(c, COD3026X_DD_CTRL_SPKS1, 0x82);
+	snd_soc_component_update_bits(c, COD3026X_70_CLK1_AD, SEL_CHCLK_AD_MASK,
+				      CHOPPING_CLK_1_BY_4 << SEL_CHCLK_AD_SHIFT);
+
+	snd_soc_component_update_bits(c, COD3026X_50_DAC1, DAC1_SOFT_MUTE_MASK,
+				      DAC1_SOFT_MUTE_MASK);
+
+	/* Microphone bias voltages from the vendor device tree: bias1 = 1, bias2 = 1, LDO = 3. */
+	snd_soc_component_update_bits(c, COD3026X_18_CTRL_REF, CTRV_MCB1_MASK,
+				      1 << CTRV_MCB1_SHIFT);
+	snd_soc_component_update_bits(c, COD3026X_82_MIC_BIAS, CTRV_MCB2_MASK,
+				      1 << CTRV_MCB2_SHIFT);
+	snd_soc_component_update_bits(c, COD3026X_82_MIC_BIAS, CTRV_MCB_LDO_MASK,
+				      3 << CTRV_MCB_LDO_SHIFT);
+	snd_soc_component_write(c, COD3026X_23_MIX_AD1, 0);
+	/* Default capture source: the main microphone only. */
+	snd_soc_component_update_bits(c, COD3026X_78_MIC_ON,
+				      EN_MIC1_MASK | EN_MIC2_MASK | EN_MIC3_MASK | EN_LN_MASK,
+				      EN_MIC1_MASK);
+
+	/* Outputs off, output mixers cleared (the power sequences set them). */
+	snd_soc_component_update_bits(c, COD3026X_17_PWAUTO_DA,
+				      PW_AUTO_DA_MASK | APW_SPK_MASK | APW_HP_MASK |
+				      APW_EP_MASK, 0);
+	snd_soc_component_write(c, COD3026X_36_MIX_DA1, 0);
+	snd_soc_component_write(c, COD3026X_37_MIX_DA2, 0);
+	/* Default route: built-in speaker selected, headphones and earpiece not. */
+	snd_soc_component_update_bits(c, COD3026X_76_CHOP_DA,
+				      EN_HP_CHOP_MASK | EN_EP_CHOP_MASK |
+				      EN_SPK_PGA_CHOP_MASK, EN_SPK_PGA_CHOP_MASK);
+
+	if (!OTP(priv, COD3026X_D4_OFFSET_DAL) && !OTP(priv, COD3026X_D5_OFFSET_DAR))
+		dev_warn(c->dev, "output offsets read as zero: probably overwritten before a warm reboot; a full power cycle reloads them\n");
+	/* Jack detection block, values from the vendor default setup. */
+	snd_soc_component_write(c, COD3026X_81_DET_ON, 0x42);
+	usleep_range(1000, 1100);
+	snd_soc_component_write(c, COD3026X_81_DET_ON, 0x43);
+	snd_soc_component_write(c, COD3026X_85_MIC_DET, 0xff);
+	snd_soc_component_write(c, COD3026X_86_DET_TIME, 0xff);
+	snd_soc_component_write(c, COD3026X_88_KEY_TIME, 0xf2);
+	snd_soc_component_write(c, COD3026X_8B_MICBIAS2, 0x0b);
+
+	priv->component = c;
+	priv->jack_report = -1;
+	INIT_DELAYED_WORK(&priv->jack_work, cod3026x_jack_work);
+	if (!snd_soc_card_jack_new(c->card, "Headset Jack", SND_JACK_HEADSET, &priv->jack))
+		queue_delayed_work(system_freezable_wq, &priv->jack_work, msecs_to_jiffies(COD3026X_JACK_POLL_MS));
+	else
+		dev_warn(c->dev, "cannot create the headset jack\n");
+
+	dev_info(c->dev, "COD3026X ready, OTP offsets %#x/%#x\n",
+		 OTP(priv, COD3026X_D4_OFFSET_DAL), OTP(priv, COD3026X_D5_OFFSET_DAR));
+	return 0;
+}
+
+static const struct snd_soc_component_driver cod3026x_component = {
+	.probe = cod3026x_component_probe,
+	.remove = cod3026x_component_remove,
+	.controls = cod3026x_controls,
+	.num_controls = ARRAY_SIZE(cod3026x_controls),
+	.dapm_widgets = cod3026x_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(cod3026x_widgets),
+	.dapm_routes = cod3026x_routes,
+	.num_dapm_routes = ARRAY_SIZE(cod3026x_routes),
+	.idle_bias_on = 1,
+	.endianness = 1,
+};
+
+static const struct regmap_config cod3026x_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int cod3026x_i2c_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct cod3026x *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	i2c_set_clientdata(i2c, priv);
+
+	priv->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(priv->vdd))
+		return dev_err_probe(dev, PTR_ERR(priv->vdd), "no vdd supply\n");
+	ret = regulator_enable(priv->vdd);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot enable vdd\n");
+
+	priv->regmap = devm_regmap_init_i2c(i2c, &cod3026x_regmap);
+	if (IS_ERR(priv->regmap)) {
+		ret = PTR_ERR(priv->regmap);
+		goto err;
+	}
+
+	ret = devm_snd_soc_register_component(dev, &cod3026x_component, &cod3026x_dai, 1);
+	if (ret)
+		goto err;
+	return 0;
+err:
+	regulator_disable(priv->vdd);
+	return ret;
+}
+
+static void cod3026x_i2c_remove(struct i2c_client *i2c)
+{
+	struct cod3026x *priv = i2c_get_clientdata(i2c);
+
+	regulator_disable(priv->vdd);
+}
+
+static const struct of_device_id cod3026x_of_match[] = {
+	{ .compatible = "j701f,cod3026x" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cod3026x_of_match);
+
+static struct i2c_driver cod3026x_i2c_driver = {
+	.driver = {
+		.name = "j701f-cod3026x",
+		.of_match_table = cod3026x_of_match,
+	},
+	.probe = cod3026x_i2c_probe,
+	.remove = cod3026x_i2c_remove,
+};
+module_i2c_driver(cod3026x_i2c_driver);
+
+MODULE_DESCRIPTION("COD3026X codec, playback only (SM-J701F local port)");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/sound/soc/samsung/j701f-audio.c
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SM-J701F sound card: Exynos7870 I2S0 -> internal audio mixer (S1402X) ->
+ * COD3026X codec. Playback, and capture from the main microphone.
+ *
+ * Written by Claude 2026-10-09 for the J701F project. The mixer register
+ * setup is ported from the vendor 3.18 sound/soc/codecs/exynos-audmixer.c
+ * (audmixer_power_on, audmixer_reset_sys_data, audmixer_init_mixer,
+ * audmixer_hw_params for the AP interface) and the I2S clocking from
+ * sound/soc/samsung/universal7870-cod3026.c (universal7870_aif1_hw_params);
+ * both are Copyright Samsung Electronics, GPL-2.0. Not an upstream driver.
+ *
+ * Only the application-processor interface of the mixer is configured: no
+ * modem (voice call), Bluetooth or FM routing.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "i2s.h"
+
+/* Mixer registers (APB: register number * 4) */
+#define MIX_SOFT_RSTB		(0x00 * 4)
+#define  MIX_RSTB_SYS		BIT(0)
+#define  MIX_RSTB_DATA		BIT(1)
+#define MIX_IN1_CTL2		(0x02 * 4)	/* AP: 32fs, I2S, 16 bit = 0 */
+#define MIX_HQ_CTL		(0x0a * 4)
+#define  MIX_HQ_MCKO_EN		BIT(2)
+#define  MIX_HQ_BCK4_MODE	BIT(1)	/* vendor "bck-mcko-mode": codec MCLK on the AIF4 BCLK line */
+#define MIX_SLOT_L		(0x0b * 4)
+#define MIX_SLOT_R		(0x0c * 4)
+#define MIX_TSLOT		(0x0e * 4)
+#define MIX_DIG_EN		(0x0f * 4)
+#define  MIX_DIG_EN_MIX		BIT(3)
+#define MIX_RMIX_CTL		(0x0d * 4)
+#define MIX_DMIX1		(0x10 * 4)
+#define  MIX_DMIX1_CH1_EN	BIT(3)	/* vendor control "CH1 Mixer En": AP stream into the mix */
+#define MIX_DMIX2		(0x11 * 4)
+#define MIX_DOUTMX1		(0x16 * 4)
+#define MIX_DOUTMX2		(0x17 * 4)
+
+/* PMU bit the vendor calls "reg-alive" for the mixer: cleared while in use */
+#define PMU_AUD_PATH_CFG	0x80
+/* 512 * 48 kHz; +100 so the divider rounds to /4 of the 98,304,019 Hz PLL, as the vendor does */
+#define MIXER_SYSCLK_48K	(24576000 + 100)
+#define J701F_RFS		512
+#define J701F_BFS		32
+#define J701F_SPK_MAX		8
+
+struct j701f_audio {
+	struct device *dev;
+	void __iomem *mixer;
+	struct clk *mixer_dout;
+	struct snd_soc_card card;
+	struct snd_soc_dai_link link;
+	struct snd_soc_dai_link_component cpu, codec, platform;
+};
+
+static void j701f_mixer_reset_data(struct j701f_audio *a)
+{
+	u32 v = readl(a->mixer + MIX_SOFT_RSTB);
+
+	writel(v & ~MIX_RSTB_DATA, a->mixer + MIX_SOFT_RSTB);
+	writel(v | MIX_RSTB_DATA, a->mixer + MIX_SOFT_RSTB);
+}
+
+static void j701f_mixer_init(struct j701f_audio *a)
+{
+	writel(0, a->mixer + MIX_SOFT_RSTB);
+	usleep_range(1000, 2000);
+	writel(MIX_RSTB_DATA | MIX_RSTB_SYS, a->mixer + MIX_SOFT_RSTB);
+	usleep_range(1000, 2000);
+
+	writel(0, a->mixer + MIX_IN1_CTL2);
+	writel(1, a->mixer + MIX_SLOT_L);		/* left = first slot */
+	writel(2, a->mixer + MIX_SLOT_R);		/* right = second slot */
+	writel(1, a->mixer + MIX_TSLOT);		/* two slots in use */
+	/* master clock to the codec; this board has "bck-mcko-mode" in the vendor tree */
+	writel(MIX_HQ_MCKO_EN | MIX_HQ_BCK4_MODE, a->mixer + MIX_HQ_CTL);
+	dev_info(a->dev, "mixer before: RMIX %#x DIG_EN %#x DMIX1 %#x DMIX2 %#x DOUTMX %#x/%#x\n",
+		 readl(a->mixer + MIX_RMIX_CTL), readl(a->mixer + MIX_DIG_EN),
+		 readl(a->mixer + MIX_DMIX1), readl(a->mixer + MIX_DMIX2),
+		 readl(a->mixer + MIX_DOUTMX1), readl(a->mixer + MIX_DOUTMX2));
+	/* Recording: give the AP interface (channel 1 output) the codec's input,
+	 * AIF4IN = 1 in the vendor "CH1 DOUT Select" control. */
+	writel((readl(a->mixer + MIX_DOUTMX1) & ~0x7) | 0x1, a->mixer + MIX_DOUTMX1);
+	/* Route the AP interface (channel 1) into the digital mixer output. */
+	writel(readl(a->mixer + MIX_DMIX1) | MIX_DMIX1_CH1_EN, a->mixer + MIX_DMIX1);
+	writel(MIX_DIG_EN_MIX, a->mixer + MIX_DIG_EN);
+	j701f_mixer_reset_data(a);
+}
+
+static int j701f_hw_params(struct snd_pcm_substream *substream,
+			   struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct j701f_audio *a = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu = snd_soc_rtd_to_cpu(rtd, 0);
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(cpu, SAMSUNG_I2S_CDCLK, J701F_RFS, SND_SOC_CLOCK_OUT);
+	if (ret < 0)
+		return ret;
+	ret = snd_soc_dai_set_sysclk(cpu, SAMSUNG_I2S_OPCLK, 0, SAMSUNG_I2S_OPCLK_PCLK);
+	if (ret < 0)
+		return ret;
+	ret = snd_soc_dai_set_sysclk(cpu, SAMSUNG_I2S_RCLKSRC_1, 0, 0);
+	if (ret < 0)
+		return ret;
+	ret = snd_soc_dai_set_clkdiv(cpu, SAMSUNG_I2S_DIV_BCLK, J701F_BFS);
+	if (ret < 0)
+		return ret;
+
+	ret = clk_set_rate(a->mixer_dout, MIXER_SYSCLK_48K);
+	if (ret)
+		return ret;
+	writel(0, a->mixer + MIX_IN1_CTL2);
+	j701f_mixer_reset_data(a);
+	return 0;
+}
+
+static const struct snd_soc_ops j701f_ops = {
+	.hw_params = j701f_hw_params,
+};
+
+static int j701f_audio_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct j701f_audio *a;
+	struct regmap *pmu;
+	struct clk *clk;
+	int ret;
+
+	a = devm_kzalloc(dev, sizeof(*a), GFP_KERNEL);
+	if (!a)
+		return -ENOMEM;
+	a->dev = dev;
+
+	a->mixer = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(a->mixer))
+		return PTR_ERR(a->mixer);
+
+	pmu = syscon_regmap_lookup_by_phandle(np, "samsung,syscon-phandle");
+	if (IS_ERR(pmu))
+		return dev_err_probe(dev, PTR_ERR(pmu), "no PMU regmap\n");
+
+	a->mixer_dout = devm_clk_get(dev, "dout");
+	if (IS_ERR(a->mixer_dout))
+		return dev_err_probe(dev, PTR_ERR(a->mixer_dout), "no mixer divider clock\n");
+	clk = devm_clk_get_enabled(dev, "sysclk");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "no mixer system clock\n");
+	clk = devm_clk_get_enabled(dev, "apb");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "no mixer bus clock\n");
+	ret = clk_set_rate(a->mixer_dout, MIXER_SYSCLK_48K);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot set mixer clock\n");
+
+	a->cpu.of_node = of_parse_phandle(np, "samsung,i2s", 0);
+	a->codec.of_node = of_parse_phandle(np, "samsung,codec", 0);
+	if (!a->cpu.of_node || !a->codec.of_node)
+		return dev_err_probe(dev, -EINVAL, "missing i2s or codec phandle\n");
+	a->cpu.dai_name = SAMSUNG_I2S_DAI;
+	a->codec.dai_name = "cod3026x-aif";
+	a->platform.of_node = a->cpu.of_node;
+
+	regmap_update_bits(pmu, PMU_AUD_PATH_CFG, BIT(0), 0);
+	j701f_mixer_init(a);
+	dev_info(dev, "mixer clock %lu Hz, SOFT_RSTB %#x DIG_EN %#x\n",
+		 clk_get_rate(a->mixer_dout), readl(a->mixer + MIX_SOFT_RSTB),
+		 readl(a->mixer + MIX_DIG_EN));
+
+	a->link.name = "j701f-cod3026x";
+	a->link.stream_name = "HiFi";
+	a->link.cpus = &a->cpu;
+	a->link.num_cpus = 1;
+	a->link.codecs = &a->codec;
+	a->link.num_codecs = 1;
+	a->link.platforms = &a->platform;
+	a->link.num_platforms = 1;
+	a->link.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC;
+	/* Power the speaker amplifier down as soon as a stream stops: it hisses when idle. */
+	a->link.ignore_pmdown_time = 1;
+	a->link.ops = &j701f_ops;
+
+	a->card.name = "J701F";
+	a->card.owner = THIS_MODULE;
+	a->card.dev = dev;
+	a->card.dai_link = &a->link;
+	a->card.num_links = 1;
+	snd_soc_card_set_drvdata(&a->card, a);
+
+	ret = devm_snd_soc_register_card(dev, &a->card);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot register sound card\n");
+
+	/*
+	 * The speaker PGA goes to 15, but on this phone anything above about 8
+	 * is far too loud and distorts (user report). Cap it so that 100 % in
+	 * the desktop volume control is the highest clean setting.
+	 */
+	ret = snd_soc_limit_volume(&a->card, "Speaker Volume", J701F_SPK_MAX);
+	if (ret)
+		dev_warn(dev, "cannot limit speaker volume: %d\n", ret);
+	return 0;
+}
+
+static const struct of_device_id j701f_audio_match[] = {
+	{ .compatible = "j701f,exynos7870-audio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, j701f_audio_match);
+
+static struct platform_driver j701f_audio_driver = {
+	.driver = {
+		.name = "j701f-audio",
+		.of_match_table = j701f_audio_match,
+	},
+	.probe = j701f_audio_probe,
+};
+module_platform_driver(j701f_audio_driver);
+
+MODULE_DESCRIPTION("SM-J701F sound card (Exynos7870 I2S, S1402X mixer, COD3026X)");
+MODULE_LICENSE("GPL");

@@ -0,0 +1,854 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * COD3026X audio codec (inside the S2MPU05 PMIC) - playback and main microphone.
+ *
+ * Written by Claude 2026-10-09 for the SM-J701F project. The register
+ * sequences are ported from the vendor 3.18 sound/soc/codecs/cod3026x.c
+ * (Copyright (c) 2014 Samsung Electronics Co. Ltd, GPL-2.0): default register
+ * setup (cod3026x_post_fw_update_failure), DAC, speaker, headphone and
+ * earpiece power sequences, the output-offset handling, and capture from the
+ * three microphone inputs (MIC1 and MIC2 on internal bias 1, the headset
+ * microphone MIC3 on bias 2). Headset insertion is reported (polled, no
+ * interrupt, no automatic re-routing yet). Line in and headset buttons are
+ * not ported. Not an upstream driver.
+ *
+ * The codec answers at I2C address 0x04, which is a reserved 7-bit address.
+ * Like the vendor tree, the device tree marks it as a ten-bit address so the
+ * I2C core accepts it; the Exynos HSI2C driver puts the plain address on the
+ * wire either way.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/jack.h>
+#include <sound/soc-dapm.h>
+#include <sound/tlv.h>
+
+#include "j701f-cod3026x-regs.h"
+
+struct cod3026x {
+	struct regmap *regmap;
+	struct regulator *vdd;
+	u8 otp[COD3026X_OTP_MAX_REG];
+	unsigned int vol_hpl;
+	unsigned int vol_hpr;
+	struct snd_soc_component *component;
+	struct snd_soc_jack jack;
+	struct delayed_work jack_work;
+	int jack_report;
+};
+
+#define COD3026X_JACK_POLL_MS	500
+
+#define OTP(priv, reg)	((priv)->otp[(reg) - COD3026X_OTP_REG_WRITE_START])
+
+struct cod3026x_outputs {
+	bool hp, spk, ep;
+};
+
+static struct cod3026x_outputs cod3026x_selected(struct snd_soc_component *c)
+{
+	unsigned int chop = snd_soc_component_read(c, COD3026X_76_CHOP_DA);
+	struct cod3026x_outputs o = {
+		.hp = chop & EN_HP_CHOP_MASK,
+		.spk = chop & EN_SPK_PGA_CHOP_MASK,
+		.ep = chop & EN_EP_CHOP_MASK,
+	};
+
+	return o;
+}
+
+static void cod3026x_update_playback_otp(struct snd_soc_component *c)
+{
+	struct cod3026x *priv = snd_soc_component_get_drvdata(c);
+	struct cod3026x_outputs o = cod3026x_selected(c);
+
+	if (!o.hp && !o.spk && !o.ep)
+		return;
+
+	if (o.hp && !o.ep) {
+		/* headphones alone or with the speaker: factory offsets */
+		snd_soc_component_write(c, COD3026X_D4_OFFSET_DAL,
+					OTP(priv, COD3026X_D4_OFFSET_DAL));
+		snd_soc_component_write(c, COD3026X_D5_OFFSET_DAR,
+					OTP(priv, COD3026X_D5_OFFSET_DAR));
+	} else if (!o.hp && !o.spk && o.ep) {
+		snd_soc_component_write(c, COD3026X_D4_OFFSET_DAL,
+					snd_soc_component_read(c, COD3026X_D7_CTRL_EP));
+	} else {
+		snd_soc_component_write(c, COD3026X_D4_OFFSET_DAL, 0);
+		snd_soc_component_write(c, COD3026X_D5_OFFSET_DAR, 0);
+	}
+
+	if (!(o.hp && !o.spk && !o.ep)) {
+		snd_soc_component_update_bits(c, COD3026X_54_DNC1, EN_DNC_MASK, 0);
+		usleep_range(100, 200);
+	}
+}
+
+/*
+ * The offset registers keep their value across a warm reboot, and the probe
+ * reads the factory values from them. Put the factory values back whenever
+ * the outputs go idle so the next boot still finds them.
+ */
+static void cod3026x_restore_otp_offsets(struct snd_soc_component *c)
+{
+	struct cod3026x *priv = snd_soc_component_get_drvdata(c);
+
+	snd_soc_component_write(c, COD3026X_D4_OFFSET_DAL, OTP(priv, COD3026X_D4_OFFSET_DAL));
+	snd_soc_component_write(c, COD3026X_D5_OFFSET_DAR, OTP(priv, COD3026X_D5_OFFSET_DAR));
+}
+
+static int cod3026x_dac_ev(struct snd_soc_dapm_widget *w,
+			   struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      PDB_DACDIG_MASK, PDB_DACDIG_MASK);
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      RSTB_DAT_DA_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      RSTB_DAT_DA_MASK, RSTB_DAT_DA_MASK);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      RSTB_DAT_DA_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      PDB_DACDIG_MASK, 0);
+		break;
+	}
+	return 0;
+}
+
+static int cod3026x_spkdrv_ev(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	struct cod3026x *priv = snd_soc_component_get_drvdata(c);
+	struct cod3026x_outputs o = cod3026x_selected(c);
+	const unsigned int dct = EN_SPK_MIX_DCTL_MASK | EN_SPK_MIX_DCTR_MASK;
+	const unsigned int mix = dct | EN_SPK_MIX_MIXL_MASK | EN_SPK_MIX_MIXR_MASK;
+	unsigned int mix_val, gain;
+
+	if (!o.spk)
+		return 0;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		cod3026x_update_playback_otp(c);
+		snd_soc_component_write(c, COD3026X_DD_CTRL_SPKS1, 0x82);
+
+		mix_val = (snd_soc_component_read(c, COD3026X_37_MIX_DA2) & mix) | dct;
+		snd_soc_component_update_bits(c, COD3026X_37_MIX_DA2, dct, 0);
+
+		gain = snd_soc_component_read(c, COD3026X_32_VOL_EP_SPK) & CTVOL_SPK_PGA_MASK;
+		snd_soc_component_update_bits(c, COD3026X_32_VOL_EP_SPK,
+					      CTVOL_SPK_PGA_MASK, 0);
+
+		snd_soc_component_update_bits(c, COD3026X_17_PWAUTO_DA,
+					      PW_AUTO_DA_MASK | APW_SPK_MASK,
+					      PW_AUTO_DA_MASK | APW_SPK_MASK);
+		snd_soc_component_update_bits(c, COD3026X_37_MIX_DA2, mix, mix_val);
+		msleep(135);
+		snd_soc_component_update_bits(c, COD3026X_32_VOL_EP_SPK,
+					      CTVOL_SPK_PGA_MASK, gain);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		gain = snd_soc_component_read(c, COD3026X_32_VOL_EP_SPK) & CTVOL_SPK_PGA_MASK;
+		snd_soc_component_update_bits(c, COD3026X_32_VOL_EP_SPK,
+					      CTVOL_SPK_PGA_MASK, 0x6);
+		snd_soc_component_update_bits(c, COD3026X_17_PWAUTO_DA,
+					      (o.hp || o.ep) ? APW_SPK_MASK :
+					      PW_AUTO_DA_MASK | APW_SPK_MASK, 0);
+		usleep_range(200, 400);
+		snd_soc_component_update_bits(c, COD3026X_37_MIX_DA2, dct, 0);
+		usleep_range(100, 200);
+		/* The vendor driver leaves 0x6 here; keep the user's gain instead. */
+		snd_soc_component_update_bits(c, COD3026X_32_VOL_EP_SPK,
+					      CTVOL_SPK_PGA_MASK, gain);
+		if (!o.hp && !o.ep)
+			cod3026x_restore_otp_offsets(c);
+
+		if (o.hp) {
+			snd_soc_component_write(c, COD3026X_D4_OFFSET_DAL,
+						OTP(priv, COD3026X_D4_OFFSET_DAL));
+			snd_soc_component_write(c, COD3026X_D5_OFFSET_DAR,
+						OTP(priv, COD3026X_D5_OFFSET_DAR));
+			snd_soc_component_write(c, COD3026X_30_VOL_HPL, 0x1a);
+			snd_soc_component_write(c, COD3026X_31_VOL_HPR, 0x1a);
+			msleep(6);
+			snd_soc_component_update_bits(c, COD3026X_54_DNC1,
+						      EN_DNC_MASK, EN_DNC_MASK);
+		}
+		break;
+	}
+	return 0;
+}
+
+static int cod3026x_hpdrv_ev(struct snd_soc_dapm_widget *w,
+			     struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	struct cod3026x *priv = snd_soc_component_get_drvdata(c);
+	struct cod3026x_outputs o = cod3026x_selected(c);
+	const unsigned int dct = EN_HP_MIXL_DCTL_MASK | EN_HP_MIXR_DCTR_MASK;
+
+	if (!o.hp)
+		return 0;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		priv->vol_hpl = snd_soc_component_read(c, COD3026X_30_VOL_HPL);
+		priv->vol_hpr = snd_soc_component_read(c, COD3026X_31_VOL_HPR);
+
+		/* vendor cod3026x_hp_playback_init() */
+		snd_soc_component_update_bits(c, COD3026X_54_DNC1,
+					      DNC_START_GAIN_MASK, DNC_START_GAIN_MASK);
+		snd_soc_component_write(c, COD3026X_5A_DNC7, 0x1a);
+		snd_soc_component_update_bits(c, COD3026X_54_DNC1,
+					      EN_DNC_MASK, EN_DNC_MASK);
+		usleep_range(100, 200);
+		snd_soc_component_update_bits(c, COD3026X_54_DNC1, EN_DNC_MASK, 0);
+		snd_soc_component_write(c, COD3026X_30_VOL_HPL, 0x1a);
+		snd_soc_component_write(c, COD3026X_31_VOL_HPR, 0x1a);
+		snd_soc_component_update_bits(c, COD3026X_19_SV_HP,
+					      SKIP_HP_SV_MASK, SKIP_HP_SV_MASK);
+		cod3026x_update_playback_otp(c);
+		snd_soc_component_update_bits(c, COD3026X_57_DNC4, DNC_WINSEL_MASK,
+					      DNC_WIN_SIZE_20HZ << DNC_WINSEL_SHIFT);
+		usleep_range(100, 200);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		snd_soc_component_update_bits(c, COD3026X_17_PWAUTO_DA,
+					      PW_AUTO_DA_MASK | APW_HP_MASK,
+					      PW_AUTO_DA_MASK | APW_HP_MASK);
+		snd_soc_component_update_bits(c, COD3026X_36_MIX_DA1, dct, dct);
+		msleep(180);
+		snd_soc_component_update_bits(c, COD3026X_19_SV_HP, SKIP_HP_SV_MASK, 0);
+
+		if (!o.spk && !o.ep) {
+			snd_soc_component_write(c, COD3026X_30_VOL_HPL, 0x1a);
+			snd_soc_component_write(c, COD3026X_31_VOL_HPR, 0x1a);
+			msleep(6);
+			snd_soc_component_update_bits(c, COD3026X_54_DNC1,
+						      EN_DNC_MASK, EN_DNC_MASK);
+		} else {
+			snd_soc_component_write(c, COD3026X_30_VOL_HPL, priv->vol_hpl);
+			snd_soc_component_write(c, COD3026X_31_VOL_HPR, priv->vol_hpr);
+		}
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		snd_soc_component_update_bits(c, COD3026X_54_DNC1, EN_DNC_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_19_SV_HP,
+					      SKIP_HP_SV_MASK, SKIP_HP_SV_MASK);
+		snd_soc_component_update_bits(c, COD3026X_17_PWAUTO_DA,
+					      (o.spk || o.ep) ? APW_HP_MASK :
+					      PW_AUTO_DA_MASK | APW_HP_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_36_MIX_DA1, dct, 0);
+		msleep(40);
+		snd_soc_component_update_bits(c, COD3026X_19_SV_HP, SKIP_HP_SV_MASK, 0);
+		break;
+	}
+	return 0;
+}
+
+static int cod3026x_epdrv_ev(struct snd_soc_dapm_widget *w,
+			     struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+	struct cod3026x_outputs o = cod3026x_selected(c);
+
+	if (!o.ep)
+		return 0;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		cod3026x_update_playback_otp(c);
+		snd_soc_component_update_bits(c, COD3026X_17_PWAUTO_DA,
+					      APW_EP_MASK | PW_AUTO_DA_MASK,
+					      APW_EP_MASK | PW_AUTO_DA_MASK);
+		snd_soc_component_update_bits(c, COD3026X_37_MIX_DA2,
+					      EN_EP_MIX_DCTL_MASK, EN_EP_MIX_DCTL_MASK);
+		msleep(136);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		snd_soc_component_update_bits(c, COD3026X_17_PWAUTO_DA,
+					      (o.spk || o.hp) ? APW_EP_MASK :
+					      PW_AUTO_DA_MASK | APW_EP_MASK, 0);
+		usleep_range(100, 200);
+		snd_soc_component_update_bits(c, COD3026X_37_MIX_DA2,
+					      EN_EP_MIX_DCTL_MASK, 0);
+		usleep_range(100, 200);
+		if (!o.hp && !o.spk)
+			cod3026x_restore_otp_offsets(c);
+		break;
+	}
+	return 0;
+}
+
+/* Vendor cod3026x_capture_init() / cod3026x_capture_deinit(). */
+static int cod3026x_vmid_ev(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(c, COD3026X_42_ADC1,
+					      ADC1_MUTE_AD_EN_MASK, ADC1_MUTE_AD_EN_MASK);
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      PDB_ADCDIG_MASK, PDB_ADCDIG_MASK);
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      RSTB_DAT_AD_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      RSTB_DAT_AD_MASK, RSTB_DAT_AD_MASK);
+
+		snd_soc_component_update_bits(c, COD3026X_10_PD_REF,
+					      PDB_VMID_MASK, PDB_VMID_MASK);
+		snd_soc_component_update_bits(c, COD3026X_18_CTRL_REF, CTMF_VMID_MASK,
+					      CTMF_VMID_5K_OM << CTMF_VMID_SHIFT);
+		snd_soc_component_update_bits(c, COD3026X_11_PD_AD1,
+					      EN_DSMR_PREQ_MASK | EN_DSML_PREQ_MASK,
+					      EN_DSMR_PREQ_MASK | EN_DSML_PREQ_MASK);
+		msleep(140);
+		snd_soc_component_update_bits(c, COD3026X_18_CTRL_REF, CTMF_VMID_MASK,
+					      CTMF_VMID_50K_OM << CTMF_VMID_SHIFT);
+		snd_soc_component_update_bits(c, COD3026X_10_PD_REF,
+					      PDB_IGEN_MASK, PDB_IGEN_MASK);
+		usleep_range(100, 200);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		snd_soc_component_update_bits(c, COD3026X_10_PD_REF, PDB_IGEN_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_10_PD_REF, PDB_VMID_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      RSTB_DAT_AD_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_40_DIGITAL_POWER,
+					      PDB_ADCDIG_MASK, 0);
+		snd_soc_component_update_bits(c, COD3026X_42_ADC1,
+					      ADC1_MUTE_AD_EN_MASK, 0);
+		break;
+	}
+	return 0;
+}

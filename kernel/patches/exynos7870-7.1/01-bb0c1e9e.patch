From bb0c1e9ed9aa43fc776feedd87ae45677b0a0066 Mon Sep 17 00:00:00 2001
From: Kaustabh Chakraborty <kauschluss@disroot.org>
Date: Wed, 18 Oct 2023 17:25:49 +0530
Subject: [PATCH] [!] add exynos7870 config fragment

---
 arch/arm64/configs/exynos7870.config | 32 ++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)
 create mode 100644 arch/arm64/configs/exynos7870.config

diff --git a/arch/arm64/configs/exynos7870.config b/arch/arm64/configs/exynos7870.config
new file mode 100644
index 000000000000..a809f35b498a
--- /dev/null
+++ b/arch/arm64/configs/exynos7870.config
@@ -0,0 +1,32 @@
+#
+# Samsung Exynos 7870 - Kernel Configuration Fragment
+#
+# This config fragment enables support for drivers available downstream, or
+# enables upstream drivers required by downstream devices.
+#
+CONFIG_LOCALVERSION="-exynos7870"
+
+#
+# Simple Framebuffer DRM Support
+#   >> drivers >> gpu >> drm >> tiny
+#
+CONFIG_DRM_SIMPLEDRM=m
+
+#
+# Touchscreens
+#   >> drivers >> input >> touchscreen
+#
+CONFIG_TOUCHSCREEN_IMAGIS=m
+
+#
+# Power Supply
+#   >> devices >> power >> supply
+#
+CONFIG_BATTERY_S2MU005=m
+
+#
+# Persistent Store
+#   >> fs >> pstore
+#
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_PMSG=y
-- 

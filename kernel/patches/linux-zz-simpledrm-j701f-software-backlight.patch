 #define DRM_SYSFB_PLANE_FORMAT_MODIFIERS \
 	DRM_FORMAT_MOD_LINEAR, \
 	DRM_FORMAT_MOD_INVALID
--- a/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
+++ b/drivers/gpu/drm/sysfb/drm_sysfb_modeset.c
@@ -239,6 +239,64 @@
 	drm_fb_xrgb8888_to_argb8888(dst, dst_pitch, src, fb, clip, state);
 }
 
+/*
+ * J701F local: software backlight. The panel has no brightness control in this
+ * kernel yet, and a compositor that darkens the picture itself needs an extra
+ * rendering pass (42 -> 20 frames per second here). simpledrm registers a
+ * backlight device instead; its level is applied here, per pixel, while the
+ * frame is copied anyway.
+ */
+static bool drm_sysfb_dimmed(struct drm_sysfb_device *sysfb, const struct drm_format_info *dst_format,
+			     const struct drm_framebuffer *fb, unsigned int *level)
+{
+	if (!sysfb->sw_backlight || sysfb->fb_addr.is_iomem)
+		return false;
+	*level = min(READ_ONCE(sysfb->sw_backlight_level), 255u);
+	if (*level == 255 || fb->format->format != DRM_FORMAT_XRGB8888)
+		return false;
+	return dst_format->format == DRM_FORMAT_ARGB8888 || dst_format->format == DRM_FORMAT_XRGB8888;
+}
+
+/*
+ * XRGB8888 to ARGB8888/XRGB8888 scaled by @level / 255; @clip is in framebuffer
+ * coordinates. Two pixels per 64-bit word: red and blue of both pixels are
+ * multiplied in one operation, green in a second one (each 8-bit field has 8
+ * spare bits above it, and the factor is at most 256). Stored as whole words,
+ * because single 32-bit stores into the uncached framebuffer are slow and a
+ * table lookup per channel cost 10 ms per frame.
+ */
+static void drm_sysfb_blit_dimmed(void *dst, unsigned int dst_pitch, const void *src,
+				  const struct drm_framebuffer *fb, const struct drm_rect *clip,
+				  unsigned int level)
+{
+	unsigned int width = drm_rect_width(clip), height = drm_rect_height(clip);
+	u64 f = level + (level >> 7);	/* 0..255 -> 0..256 */
+	unsigned int x, y;
+
+	src += clip->y1 * fb->pitches[0] + clip->x1 * sizeof(u32);
+	for (y = 0; y < height; y++) {
+		const u32 *s = src;
+		u32 *d = dst;
+
+		for (x = 0; x + 1 < width; x += 2) {
+			u64 v = get_unaligned((const u64 *)(s + x));
+			u64 rb = (((v & 0x00ff00ff00ff00ffULL) * f) >> 8) & 0x00ff00ff00ff00ffULL;
+			u64 g = ((((v >> 8) & 0x000000ff000000ffULL) * f) & 0x0000ff000000ff00ULL);
+
+			put_unaligned(rb | g | 0xff000000ff000000ULL, (u64 *)(d + x));
+		}
+		if (x < width) {
+			u32 p = s[x];
+			u32 rb = (((p & 0x00ff00ff) * (u32)f) >> 8) & 0x00ff00ff;
+			u32 g = (((p >> 8) & 0xff) * (u32)f) & 0x0000ff00;
+
+			d[x] = rb | g | 0xff000000;
+		}
+		src += fb->pitches[0];
+		dst += dst_pitch;
+	}
+}
+
 static drm_sysfb_blit_func drm_sysfb_get_blit_func(u32 dst_format, u32 src_format)
 {
 	if (src_format == dst_format) {
@@ -383,8 +441,12 @@

 EXPORT_SYMBOL(drm_sysfb_plane_helper_atomic_update);
 
+/**
+ * drm_sysfb_plane_redraw - copy the plane's current framebuffer out again
+ * @plane: the primary plane
+ *
+ * J701F local: called when the software backlight level changes, because the
+ * level is baked into the pixels and nothing else would repaint a still picture.
+ */
+void drm_sysfb_plane_redraw(struct drm_plane *plane)
+{
+	struct drm_device *dev = plane->dev;
+	struct drm_sysfb_device *sysfb = to_drm_sysfb_device(dev);
+	struct drm_format_conv_state fmtcnv = DRM_FORMAT_CONV_STATE_INIT;
+	struct iosys_map map[DRM_FORMAT_MAX_PLANES], data[DRM_FORMAT_MAX_PLANES];
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_plane_state *plane_state;
+	struct drm_framebuffer *fb;
+	int ret, idx;
+
+	DRM_MODESET_LOCK_ALL_BEGIN(dev, ctx, 0, ret);
+	plane_state = plane->state;
+	fb = plane_state ? plane_state->fb : NULL;
+	if (fb && plane_state->visible && plane_state->crtc && drm_dev_enter(dev, &idx)) {
+		struct drm_sysfb_plane_state *sysfb_plane_state = to_drm_sysfb_plane_state(plane_state);
+		const struct drm_format_info *dst_format =
+			to_drm_sysfb_crtc_state(plane_state->crtc->state)->format;
+		unsigned int dst_pitch = sysfb->fb_pitch;
+		struct iosys_map dst = sysfb->fb_addr;
+		struct drm_rect full = plane_state->dst;
+		unsigned int level;
+
+		if (!drm_gem_fb_vmap(fb, map, data)) {
+			if (!drm_gem_fb_begin_cpu_access(fb, DMA_FROM_DEVICE)) {
+				iosys_map_incr(&dst, drm_fb_clip_offset(dst_pitch, dst_format, &full));
+				if (drm_sysfb_dimmed(sysfb, dst_format, fb, &level))
+					drm_sysfb_blit_dimmed(dst.vaddr, dst_pitch, data[0].vaddr,
+							      fb, &full, level);
+				else if (sysfb_plane_state->blit_to_crtc)
+					sysfb_plane_state->blit_to_crtc(&dst, &dst_pitch, data, fb,
+									&full, &fmtcnv);
+				drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
+			}
+			drm_gem_fb_vunmap(fb, map);
+		}
+		drm_dev_exit(idx);
+	}
+	DRM_MODESET_LOCK_ALL_END(dev, ctx, ret);
+	drm_format_conv_state_release(&fmtcnv);
+}
+EXPORT_SYMBOL(drm_sysfb_plane_redraw);
+
 void drm_sysfb_plane_helper_atomic_disable(struct drm_plane *plane,
 					   struct drm_atomic_state *state)
 {
--- a/drivers/gpu/drm/sysfb/simpledrm.c
+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
 #include <linux/aperture.h>
+#include <linux/backlight.h>
 #include <linux/clk.h>
 #include <linux/minmax.h>
 #include <linux/of_address.h>
@@ -560,6 +561,25 @@
 	.destroy = drm_plane_cleanup,
 };
 
+/*
+ * J701F local: software backlight, see drm_sysfb_modeset.c. Enabled by the
+ * boolean device-tree property "j701f,software-backlight"; the connector is
+ * then also reported as DSI, which it is, so that the desktop treats the
+ * output as the built-in panel and uses this device for its brightness.
+ */
+static int simpledrm_backlight_update(struct backlight_device *bl)
+{
+	struct simpledrm_device *sdev = bl_get_data(bl);
+
+	WRITE_ONCE(sdev->sysfb.sw_backlight_level, backlight_get_brightness(bl));
+	drm_sysfb_plane_redraw(&sdev->primary_plane);
+	return 0;
+}
+
+static const struct backlight_ops simpledrm_backlight_ops = {
+	.update_status = simpledrm_backlight_update,
+};
+
 static const struct drm_crtc_helper_funcs simpledrm_crtc_helper_funcs = {
 	DRM_SYSFB_CRTC_HELPER_FUNCS,
 };
@@ -795,8 +815,28 @@
 	/* Connector */
 
 	connector = &sdev->connector;
+	if (pdev->dev.of_node && !sysfb->fb_addr.is_iomem &&
+	    of_property_read_bool(pdev->dev.of_node, "j701f,software-backlight") &&
+	    (format->format == DRM_FORMAT_ARGB8888 || format->format == DRM_FORMAT_XRGB8888)) {
+		struct backlight_properties props = {
+			.type = BACKLIGHT_RAW,
+			.max_brightness = 255,
+			.brightness = 255,
+		};
+		struct backlight_device *bl;
+
+		sysfb->sw_backlight_level = 255;
+		bl = devm_backlight_device_register(&pdev->dev, "j701f-panel", &pdev->dev, sdev,
+						    &simpledrm_backlight_ops, &props);
+		if (!IS_ERR(bl)) {
+			sysfb->sw_backlight = true;
+			drm_info(dev, "software backlight registered (J701F local)\n");
+		}
+	}
+
 	ret = drm_connector_init(dev, connector, &simpledrm_connector_funcs,
-				 DRM_MODE_CONNECTOR_Unknown);
+				 sysfb->sw_backlight ? DRM_MODE_CONNECTOR_DSI :
+						       DRM_MODE_CONNECTOR_Unknown);
 	if (ret)
 		return ERR_PTR(ret);
 	drm_connector_helper_add(connector, &simpledrm_connector_helper_funcs);

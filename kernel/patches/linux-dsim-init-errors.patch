From: Codex <codex@localhost>
Subject: [PATCH] drm/bridge: samsung-dsim: propagate host initialisation failures

A failed PLL/clock setup or link initialisation must not leave the host
marked INITIALIZED and allow transfers to continue. Return the original
error, unwind IRQ and clock state, and make reset timeout an error too.
The existing successful ordering is retained.

Host regressions inject each failure and retry the actual init callback.
No hardware output result is claimed.
---

diff --git a/drivers/gpu/drm/bridge/samsung-dsim.c b/drivers/gpu/drm/bridge/samsung-dsim.c
--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -712,12 +712,13 @@
 	return readl(dsi->reg_base + dsi->driver_data->reg_ofs[idx]);
 }
 
-static void samsung_dsim_wait_for_reset(struct samsung_dsim *dsi)
+static int samsung_dsim_wait_for_reset(struct samsung_dsim *dsi)
 {
 	if (wait_for_completion_timeout(&dsi->completed, msecs_to_jiffies(300)))
-		return;
+		return 0;
 
 	dev_err(dsi->dev, "timeout waiting for reset\n");
+	return -ETIMEDOUT;
 }
 
 static void samsung_dsim_reset(struct samsung_dsim *dsi)
@@ -1637,6 +1638,7 @@
 static int samsung_dsim_init(struct samsung_dsim *dsi)
 {
 	const struct samsung_dsim_driver_data *driver_data = dsi->driver_data;
+	int ret;
 
 	if (dsi->state & DSIM_STATE_INITIALIZED)
 		return 0;
@@ -1647,15 +1649,27 @@
 	if (driver_data->reg_values[RESET_TYPE] == DSIM_FUNCRST)
 		samsung_dsim_enable_lane(dsi, BIT(dsi->lanes) - 1);
 
-	samsung_dsim_enable_clock(dsi);
-	if (driver_data->wait_for_reset)
-		samsung_dsim_wait_for_reset(dsi);
+	ret = samsung_dsim_enable_clock(dsi);
+	if (ret)
+		goto err_disable;
+	if (driver_data->wait_for_reset) {
+		ret = samsung_dsim_wait_for_reset(dsi);
+		if (ret)
+			goto err_disable;
+	}
 	samsung_dsim_set_phy_ctrl(dsi);
-	samsung_dsim_init_link(dsi);
+	ret = samsung_dsim_init_link(dsi);
+	if (ret)
+		goto err_disable;
 
 	dsi->state |= DSIM_STATE_INITIALIZED;
 
 	return 0;
+
+err_disable:
+	samsung_dsim_disable_irq(dsi);
+	samsung_dsim_disable_clock(dsi);
+	return ret;
 }
 
 static void samsung_dsim_atomic_pre_enable(struct drm_bridge *bridge,

# Compile bring-up target only: no J701F board DT exists yet in this source.
CONFIG_LOCALVERSION="-BURAK-PANFROST-01"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZMA=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
# J701F USB device-side keyboard for the handheld toolbox; no host-mode changes.
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_DEBUG_FS=y
# Avoid large debug objects in the bounded tmpfs build workspace.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# Claude 2026-10-08: userspace I2C access for the S2MU005 MUIC USB-path diagnostic.
CONFIG_I2C_CHARDEV=y
# Claude 2026-10-08: Melfas MMS438 (MIP4) touchscreen on the J701F.
CONFIG_TOUCHSCREEN_MELFAS_MIP4=y
# Claude 2026-10-08: built-in Wi-Fi stack for the BCM43438 (the Alpine root has
# no /lib/modules for this kernel). IPv6 built in for the same reason.
CONFIG_CFG80211=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_IPV6=y
CONFIG_RFKILL=y
# Handheld toolbox: enable the controller's Bluetooth Low Energy host stack.
CONFIG_BT_LE=y
# Keep first BLE trial to basic LE; the controller's 5.2 ECRED path is untested.
# CONFIG_BT_LE_L2CAP_ECRED is not set
# Claude 2026-10-09: 7.1 base. The exynos7870/postmarketOS fragments build these
# as modules; the Alpine root has no /lib/modules, so they must be built in.
CONFIG_DRM=y
CONFIG_DRM_PANFROST=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_SAMSUNG_DSIM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_PSTORE_RAM=y
CONFIG_BATTERY_S2MU005=y
# Session conveniences found missing under Plasma on 6.15.
CONFIG_FUSE_FS=y
CONFIG_INPUT_UINPUT=y
CONFIG_ZRAM=y
# The USB PHY follows TYPEC (tristate dependency); built in for the same reason.
CONFIG_TYPEC=y
# Claude 2026-10-09: 7.1's exynos7870 fragment leaves every other arm64 SoC family
# enabled (44 MB Image). Only Exynos is needed on this phone.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# 7.1 pwrseq-simple takes its single reset GPIO through the reset-gpio driver;
# as a module it never loads here and the SDIO Wi-Fi host stays deferred.
CONFIG_RESET_GPIO=y
# Claude 2026-10-09: capacitive back/recents keys (Coreriver TC3xx, untested match).
CONFIG_KEYBOARD_TM2_TOUCHKEY=y
# Claude 2026-10-09: Bluetooth (BCM43438 over UART) and the ST accelerometer, built in.
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=y
CONFIG_IIO_ST_ACCEL_3AXIS=y
CONFIG_IIO_ST_ACCEL_I2C_3AXIS=y
# Claude 2026-10-09: audio stage 1. ALSA core built in; the Samsung I2S and the local
# LPASS driver are modules on purpose: they are loaded by hand over SSH so a crash
# is caught by ramoops and the next boot is clean.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SAMSUNG=m
CONFIG_SND_SAMSUNG_I2S=m
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SIMPLE_CARD_UTILS=y
# Claude 2026-10-09: vibration motor is a switched regulator (vendor sec_vib)
CONFIG_INPUT_REGULATOR_HAPTIC=y
# Claude 2026-10-09: proximity sensor (Capella CM36672P)
CONFIG_VCNL4000=y
# Claude 2026-10-09: Bluetooth pairing needs AES built in (CMAC context); HID and RFCOMM profiles
CONFIG_CRYPTO_AES=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
# Claude 2026-10-10: suspend bring-up (/sys/power/pm_test, pm_print_times, pm_debug_messages).
# PM_ADVANCED_DEBUG was on for one night and is deliberately off again: see docs/j701f-mainline.md
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# Uninstalled RAM handoff candidate. No flash interfaces or storage fallback.
CONFIG_LOCALVERSION="-BURAK-J701F-DIAGNOSTIC-02"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_DEVICE_TREE="exynos/exynos7870-j7velte"
CONFIG_OF_LIST="exynos/exynos7870-j7velte"
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_GADGET_DOWNLOAD is not set
# CONFIG_USB_FUNCTION_ACM is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_USB_FUNCTION_MASS_STORAGE is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_MMC is not set
CONFIG_BOOTDELAY=0
CONFIG_SYS_DEVICE_NULLDEV=y
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
# CONFIG_SERIAL_PRESENT is not set
# CONFIG_SYS_I2C_S3C24X0 is not set
# CONFIG_DM_PMIC is not set
# CONFIG_DM_REGULATOR is not set
# CONFIG_PHY is not set
# CONFIG_MMC_DW is not set
# CONFIG_MMC_WRITE is not set
# CONFIG_CMD_FS_GENERIC is not set
# CONFIG_FS_EXT4 is not set
# CONFIG_FS_FAT is not set
# CONFIG_EFI_LOADER is not set
# Board matching uses cmdline_get_arg from bootflow.c. No bootflow scan runs.
CONFIG_BOOTSTD=y
# CONFIG_BOOTSTD_DEFAULTS is not set
# CONFIG_BOOTSTD_BOOTCOMMAND is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="j701f_ramboot"
# CONFIG_VIDEO is not set
# CONFIG_BUTTON_CMD is not set
# CONFIG_BUTTON_KEYBOARD is not set
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_FIT=y
CONFIG_FIT_FULL_CHECK=y
CONFIG_SHA256=y

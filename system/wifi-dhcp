#!/bin/sh
# BusyBox udhcpc hook for the single wlan0 connection.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "$interface" = wlan0 ] || exit 1
case "$1" in
    deconfig)
        ip -4 addr flush dev "$interface"
        while ip -4 route del default dev "$interface" 2>/dev/null; do :; done
        ;;
    bound|renew)
        [ -n "$ip" ] && [ -n "$mask" ] || exit 1
        if ! ip -4 addr show dev "$interface" | grep -Fq "inet $ip/$mask "; then
            ip -4 addr flush dev "$interface" || exit 1
            ip -4 addr add "$ip/$mask" dev "$interface" || exit 1
        fi
        while ip -4 route del default dev "$interface" 2>/dev/null; do :; done
        for gateway in $router; do
            ip -4 route add default via "$gateway" dev "$interface" && break
        done
        if [ -n "$dns" ]; then
            resolv_tmp=$(mktemp /etc/resolv.conf.XXXXXX) || exit 1
            for server in $dns; do printf 'nameserver %s\n' "$server"; done > "$resolv_tmp"
            chmod 644 "$resolv_tmp"
            mv -f "$resolv_tmp" /etc/resolv.conf
        fi
        ;;
    leasefail|nak) printf 'Wi-Fi DHCP: %s\n' "$1" >&2 ;;
    *) exit 1 ;;
esac

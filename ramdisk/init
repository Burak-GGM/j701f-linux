#!/bin/sh
# PID 1 stays alive; all automatic mounts are RAM-backed/kernel virtual filesystems.
export PATH=/bin
export HOME=/
export TERM=vt100
export PS1='j701f-linux # '
umask 022

log() {
    printf '%s\n' "$*"
    (printf '%s\n' "$*" >> /tmp/boot.log) 2>/dev/null || :
    if [ -c /dev/kmsg ]; then
        (printf '<6>j701f-linux: %s\n' "$*" > /dev/kmsg) 2>/dev/null || :
    fi
    if [ -c /dev/console ]; then
        (printf '%s\n' "$*" > /dev/console) 2>/dev/null || :
    fi
}

mount -t proc -o nosuid,nodev,noexec proc /proc || log 'WARNING: proc mount failed'
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys || log 'WARNING: sysfs mount failed'
if ! mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev; then
    log 'devtmpfs unavailable; using initramfs device nodes'
fi
# devtmpfs can cover the device nodes shipped in the archive. Restore if absent.
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3
[ -c /dev/kmsg ] || mknod -m 600 /dev/kmsg c 1 11
[ -c /dev/tty ] || mknod -m 666 /dev/tty c 5 0
mkdir -p /dev/pts
mount -t devpts -o nosuid,noexec,mode=0620 devpts /dev/pts || log 'WARNING: devpts mount failed'
mount -t tmpfs -o nosuid,nodev,mode=1777,size=16m tmpfs /tmp || log 'Using initramfs /tmp'

# Independent children: a blocked display driver cannot prevent USB startup.
printf '%s\n' 'Stage 1 /init reached diagnostics startup' > /tmp/stage1-ready
/bin/display-status >> /tmp/display.log 2>&1 &
/bin/usb-debug >> /tmp/usb.log 2>&1 &

log "HELLO FROM BURAK'S J701F LINUX RECOVERY"
log "Kernel: $(uname -a)"
[ ! -r /proc/version ] || log "Version: $(cat /proc/version)"
[ ! -r /proc/cmdline ] || log "Command line: $(cat /proc/cmdline)"
[ ! -r /proc/consoles ] || log "Consoles: $(cat /proc/consoles)"
log 'RAM-only userspace. USB serial and touchscreen terminal started. No block partitions mounted.'
log 'Loader layout inspection: boot-manager inspect (read-only).'
printf '%s\n' 'Stage 1 /init reached shell loop' > /tmp/stage1-ready

# Avoid exiting PID 1 (kernel panic). Child shells may exit and are restarted.
# Prefer a concrete console reported by the running kernel for job control.
# /dev/console itself may reject the controlling-terminal ioctl.
shell_console=/dev/console
if [ -r /proc/consoles ]; then
    while read -r name rest; do
        case "$name" in ''|*[!a-zA-Z0-9_.-]*) continue ;; esac
        [ ! -c "/dev/$name" ] || shell_console="/dev/$name"
    done < /proc/consoles
fi
trap 'log "PID 1 remains alive"' INT TERM HUP
while :; do
    log 'Starting interactive console shell; type exit to restart it.'
    if ( : < "$shell_console" > "$shell_console" ) 2>/dev/null; then
        setsid -c /bin/sh -i < "$shell_console" > "$shell_console" 2>&1 || {
            log 'Controlling terminal unavailable; trying shell without job control'
            /bin/sh -i < "$shell_console" > "$shell_console" 2>&1
        }
    else
        log 'Console cannot be opened; trying inherited descriptors'
        /bin/sh -i
    fi
    log 'Shell ended; restarting in 2 seconds'
    sleep 2
done
